kernel_build(
    name = "rockchip",
    outs = [
        "Image",
        "System.map",
        "modules.builtin",
        "modules.builtin.modinfo",
        "vmlinux",
        "vmlinux.symvers",
    ],
    srcs = [":kernel_aarch64_sources"],
    arch = "arm64",
    defconfig = "arch/arm64/configs/gki_defconfig",
    base_kernel = ":kernel_aarch64",
    collect_unstripped_modules = True,
    kmi_symbol_list = "gki/aarch64/symbols/rockchip",
    make_goals = [
        "Image",
        "modules",
    ],
    makefile = ":Makefile",
    pre_defconfig_fragments = [
        "arch/arm64/configs/rockchip_gki.config",
        "kernel/configs/bifrost_gpu_gki.config",
        ],
    module_outs = _ROCKCHIP_MODULE_OUTS,
    strip_modules = True,
    visibility = ["//visibility:private"],
)

kernel_abi(
    name = "rockchip_abi",
    kernel_build = ":rockchip",
    kmi_symbol_list_add_only = True
)

kernel_modules_install(
    name = "rockchip_modules_install",
    kernel_build = ":rockchip",
)

merged_kernel_uapi_headers(
    name = "rockchip_merged_kernel_uapi_headers",
    kernel_build = ":rockchip",
)

initramfs(
    name = "rockchip_initramfs",
    kernel_modules_install = ":rockchip_modules_install",
    visibility = ["//visibility:private"],
)

pkg_files(
    name = "rockchip_dist_files",
    srcs = [
        ":rockchip",
        ":rockchip_initramfs",
        ":rockchip_modules_install",
        ":rockchip_merged_kernel_uapi_headers",
        ":kernel_aarch64",
        ":kernel_aarch64_modules",
        ":kernel_aarch64_additional_artifacts",
        ":tests_zip_arm64",
    ],
    strip_prefix = strip_prefix.files_only(),
    visibility = ["//visibility:private"],
)

pkg_install(
    name = "rockchip_dist",
    srcs = [":rockchip_dist_files"],
    destdir = "out/rockchip/dist",
)

